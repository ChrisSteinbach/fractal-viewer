{
  "name": "fractal-viewer",
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive 3D IFS fractal explorer (chaos game) built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/collect-third-party-licenses.mjs && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/webgl-smoke.mjs",
    "bench:gpu": "node scripts/gpu-flame-bench.mjs",
    "bench:surface": "node scripts/gpu-flame-bench.mjs --surface-only",
    "bench:mesh-sdf": "node scripts/mesh-sdf-bench.ts",
    "verify:pattern-release": "npm run build && node scripts/pattern-release.verify.mjs",
    "verify:pattern-release-review": "node scripts/pattern-release-review-score.ts",
    "test": "npm run lint && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && tsc --noEmit -p src/app/sw && tsc --noEmit -p scripts && eslint src/ \"scripts/**/*.ts\" && stylelint \"src/**/*.css\" && prettier --check .",
    "lint:fix": "eslint src/ \"scripts/**/*.ts\" --fix && stylelint \"src/**/*.css\" --fix && prettier --write .",
    "lint:stylelint": "stylelint \"src/**/*.css\"",
    "lint:eslint": "eslint src/ \"scripts/**/*.ts\"",
    "lint:eslint:fix": "eslint src/ \"scripts/**/*.ts\" --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisSteinbach/fractal-viewer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@webgpu/types": "^0.1.72",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0",
    "workbox-precaching": "^7.4.1"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
