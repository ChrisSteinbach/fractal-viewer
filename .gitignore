node_modules/
dist/
dev-dist/
coverage/
.idea/
.playwright-mcp/

# Dolt database files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/
# Beads tracker state syncs via the bd dolt remote (bd dolt push/pull) —
# the jsonl mirrors are regenerated locally and never committed.
.beads/*.jsonl
.beads/hooks/
*.db
.prep-pr/
.dispatch/

# Local benchmark artifacts (gpu-bench runner output, ad-hoc result dumps).
bench-results/
/gpu-ci-plan.json
/result.json
# Phone soak monitor output (gpu-flame-soak.mjs).
soak-log/
# Harness image output (qjulia-preview.harness.ts and friends) — regenerate
# by re-running the harness rather than committing megabytes of PNG.
scripts/out/

# Generated at build time by scripts/collect-third-party-licenses.mjs.
src/app/public/THIRD-PARTY-LICENSES.txt

.eslintcache

# Browser diagnostic dumps (chrome://gpu saved for a session to read).
/GPUInternals.html
/IrisGPUInternals.html

.claude/worktrees/
bench-results/
bench-results-main/
bench-results-sw/
